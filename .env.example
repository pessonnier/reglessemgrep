# Optional CAST Extend account. Leave either value empty for public-only collection.
CAST_USERNAME=
CAST_PASSWORD=

# OpenAI embeddings: local secret, never commit the filled .env file.
OPENAI_API_KEY=

# Local application configuration.
COMPARATOR_DB=data/comparator.sqlite3
COMPARATOR_DATA_DIR=data/raw
CAST_REQUEST_INTERVAL=0.35

